---
import { hamtaSida, hamtaLista } from '../lib/sanity';

const sida = await hamtaSida("sidaStart");
const services = await hamtaLista("services");
---

<section class="sektion"><h2>Det här gör vi bäst</h2><p>Tre saker, ordentligt gjorda, i stället för tio halvfärdiga.</p><div class="rutor">
  {services.map((post) => (
    <div class="ruta"><h3>{post.rubrik}</h3><p>{post.text}</p></div>
  ))}
</div><div class="bild"></div></section>
