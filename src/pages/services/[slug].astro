---
import Bas from '../../layouts/Bas.astro'
import {sanityClient} from '../../lib/sanity'
import {PortableText} from 'astro-portabletext'

// getStaticPaths körs i egen modulkontext – frågan måste därför stå här inne.
export async function getStaticPaths() {
  const {sanityClient} = await import('../../lib/sanity')
  return await sanityClient.fetch(
    '*[_type == $typ && defined(slug.current)]{"params": {"slug": slug.current}}',
    {typ: "services"},
  )
}

const {slug} = Astro.params
const post = await sanityClient.fetch(
  '*[_type == $typ && slug.current == $slug][0]',
  {typ: "services", slug},
)
---

<Bas title={post?.rubrik ?? ''}>
  <article class="sektion">
    <h1>{post?.rubrik}</h1>
    {post?.innehall && <PortableText value={post.innehall} />}
  </article>
</Bas>
